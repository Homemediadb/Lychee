<UserControl x:Class="DiscBg.Gui.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DiscBg.Gui.Controls">
    <Grid RowDefinitions="Auto,*">
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="FileBar" Padding="12,10,16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="BeforeButton" AutomationProperties.Name="Before" MinWidth="88" CornerRadius="4,0,0,4" Click="OnViewToggle"
                                  ToolTipService.ToolTip="The scan as opened">
                        <TextBlock Text="Before" />
                    </ToggleButton>
                    <ToggleButton x:Name="AfterButton" AutomationProperties.Name="After" MinWidth="88" CornerRadius="0,4,4,0" IsChecked="True" Click="OnViewToggle"
                                  ToolTipService.ToolTip="With the background removed, exactly as saved">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="AfterRing" Style="{StaticResource ButtonRing}" Visibility="Collapsed" />
                            <TextBlock Text="After" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="InfoPanel" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FormatText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="For the best results use a raw lossless scan without any color correction or adjustments"
                               ToolTipService.ToolTip="For the best results use a raw lossless scan without any color correction or adjustments" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
                <Button x:Name="SaveButton" Grid.Column="2" Width="144" AutomationProperties.Name="Export As" Click="OnSave" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Export the result as a PNG with transparency">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export As" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,176">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid x:Name="StageArea" SizeChanged="OnStageAreaSizeChanged">
                    <controls:StageView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <controls:BackdropList x:Name="Backdrops" Margin="16" />
            </ScrollViewer>
        </Grid>

        <controls:SaveOverlay x:Name="SaveOverlay" Grid.RowSpan="2" />
    </Grid>
</UserControl>
