<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DiscBg.Gui</RootNamespace>
    <AssemblyName>DiscBg</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Builds Lychee.pri on publish too, which unpackaged apps otherwise skip -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\disc.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <WindowsAppSDKVersion>2.5.1</WindowsAppSDKVersion>
    <!-- Source-generated P/Invoke -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the Windows App SDK parts used: the metapackage adds ~60 MB never loaded -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscBg.Core\DiscBg.Core.csproj" />
  </ItemGroup>
  <Target Name="StripPublish" AfterTargets="Publish">
    <ItemGroup>
      <_Strip Include="$(PublishDir)*.pdb;$(PublishDir)createdump.exe;$(PublishDir)mscordbi.dll;$(PublishDir)mscordaccore*.dll;$(PublishDir)Microsoft.DiaSymReader.Native.*.dll" />
    </ItemGroup>
    <Delete Files="@(_Strip)" />
  </Target>
</Project>
