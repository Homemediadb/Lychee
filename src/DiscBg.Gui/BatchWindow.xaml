<Window x:Class="DiscBg.Gui.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TitleBar x:Name="AppTitleBar" Title="Batch Mode">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/disc.png" />
                </TitleBar.IconSource>
            </TitleBar>
        </Border>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Text="Output folder" VerticalAlignment="Center" />
                <TextBox x:Name="FolderBox" Grid.Column="1" IsReadOnly="True" PlaceholderText="Choose where the results go"
                         AutomationProperties.Name="Output folder" />
                <Button Grid.Column="2" Content="Browse…" Click="OnBrowse" AutomationProperties.Name="Choose the output folder" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="Items" Padding="16" Spacing="8" />
        </ScrollViewer>
        <StackPanel x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="24">
            <FontIcon Glyph="&#xE896;" FontSize="40" Opacity="0.6" />
            <TextBlock Text="Drop scans here, or click Add Files" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Style="{StaticResource Hint}"
                       Text="Each scan is processed in turn and saved as a PNG in the output folder, named like an export. With 2-pass Mode, add the scans over white and over black together: they're paired up automatically." />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" AutomationProperties.Name="Cancel the batch"
                        ToolTipService.ToolTip="Stop: the scan being worked on isn't saved, and the ones waiting aren't started" />
                <TextBlock x:Name="ProgressText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <CheckBox x:Name="TwoPassBox" Grid.Column="2" Content="2-pass Mode" MinWidth="0" Click="OnTwoPassClick" VerticalAlignment="Center">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <TextBlock TextWrapping="Wrap" MaxWidth="340"
                                       Text="Add each disc's scan over white and its scan over black together: they're paired by looking at them (the same size, and the same disc in the same place). Only sure pairs are made: a scan left without one isn't done, and says so." />
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </CheckBox>
                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnAddFiles" AutomationProperties.Name="Add Files"
                        ToolTipService.ToolTip="Add scans: each is processed in turn and saved as a PNG in the output folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Add Files" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
