<UserControl
    x:Class="Lychee.Gui.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ProgressRing
            x:Name="Spinner"
            Width="40"
            Height="40"
            AutomationProperties.Name="Opening"
            IsActive="False"
            Visibility="Collapsed" />
        <ScrollViewer x:Name="Steps" Padding="40,0">
            <StackPanel
                MaxWidth="560"
                Margin="0,48"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Let's get started" />

                <StackPanel Margin="0,24,0,64" Spacing="32">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Style="{StaticResource StepNumberText}" Text="1" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource StepText}"
                            Text="Open or drop scans of discs on a white background." />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Style="{StaticResource StepNumberText}" Text="2" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource StepText}"
                            Text="For see-through clear plastic, add the same disc scanned over black (Matting)." />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Style="{StaticResource StepNumberText}" Text="3" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource StepText}"
                            Text="Export a transparent PNG." />
                    </Grid>
                </StackPanel>

                <Button
                    Height="44"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Open Scans"
                    Click="OnOpen"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        <TextBlock Text="Open Scans" />
                    </StackPanel>
                </Button>
                <Button
                    Height="44"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Batch Mode"
                    Click="OnBatch"
                    ToolTipService.ToolTip="Process many scans into a folder, one after another">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                        <TextBlock Text="Batch Mode" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
