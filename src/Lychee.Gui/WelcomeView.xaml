<UserControl x:Class="Lychee.Gui.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="40,0">
        <StackPanel MaxWidth="560" Margin="0,48" VerticalAlignment="Center">
            <TextBlock Text="Let's get started" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="32" Margin="0,24,0,64">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Text="Open or drop scans of discs on a white background."
                               Grid.Column="1" Style="{StaticResource StepText}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Text="For see-through clear plastic, add the same disc scanned over black (Matting)."
                               Grid.Column="1" Style="{StaticResource StepText}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepNumberText}" /></Border>
                    <TextBlock Text="Export a transparent PNG."
                               Grid.Column="1" Style="{StaticResource StepText}" />
                </Grid>
            </StackPanel>

            <Button HorizontalAlignment="Stretch" Height="44" Style="{StaticResource AccentButtonStyle}" Click="OnOpen" AutomationProperties.Name="Open Scans">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Open Scans" />
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" Height="44" Margin="0,8,0,0" Click="OnBatch" AutomationProperties.Name="Batch Mode"
                    ToolTipService.ToolTip="Process many scans into a folder, one after another">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    <TextBlock Text="Batch Mode" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
