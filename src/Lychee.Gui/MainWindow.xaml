<Window x:Class="Lychee.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Lychee.Gui"
        xmlns:controls="using:Lychee.Gui.Controls">
    <Grid x:Name="Root" RowDefinitions="Auto,*" Background="Transparent">
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TitleBar x:Name="AppTitleBar" Title="Lychee">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/icon.png" />
                </TitleBar.IconSource>
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarIconMaxWidth">24</x:Double>
                    <x:Double x:Key="TitleBarIconMaxHeight">24</x:Double>
                    <Thickness x:Key="TitleBarIconMargin">0,0,8,0</Thickness>
                    <Thickness x:Key="TitleBarTitleMargin">0,0,18,0</Thickness>
                    <!-- The template reserves a drag gap before the caption buttons -->
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
                    <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>
                    <StaticResource x:Key="TitleBarDeactivatedForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
                </TitleBar.Resources>
                <TitleBar.RightHeader>
                    <SelectorBar x:Name="TitleButtons" SelectionChanged="OnTitleButtonSelected">
                        <SelectorBarItem Tag="kofi" ToolTipService.ToolTip="Support on Ko-fi" AutomationProperties.Name="Support on Ko-fi">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xEB51;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Tag="about" ToolTipService.ToolTip="About" AutomationProperties.Name="About">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem Tag="settings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                </TitleBar.RightHeader>
                <TabView x:Name="Tabs" VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                         CanReorderTabs="True" CanDragTabs="False"
                         AddTabButtonClick="OnAddTab" TabCloseRequested="OnTabCloseRequested"
                         SelectionChanged="OnTabSelectionChanged">
                    <TabView.Resources>
                        <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
                        <x:Double x:Key="TabViewItemHeaderFontSize">13</x:Double>
                        <!-- Rounded on all corners: the selected tab's feet are hidden and its fill moved -->
                        <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                        <Style TargetType="TabViewItem">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </TabView.Resources>
                </TabView>
            </TitleBar>
        </Border>

        <Grid x:Name="PagesHost" Grid.Row="1" Background="Transparent" AllowDrop="True"
              DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
            <local:WelcomeView x:Name="Welcome" />
        </Grid>

        <!-- Code copies this fill: it can't look up a ThemeResource -->
        <Border x:Name="SelectedFill" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

        <controls:DropOverlay x:Name="DropZone" Grid.Row="1" />
    </Grid>
</Window>
