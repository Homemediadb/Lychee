<Window
    x:Class="Lychee.Gui.BatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnDragOver"
        Drop="OnDrop"
        RowDefinitions="Auto,Auto,*,Auto">
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TitleBar x:Name="AppTitleBar" Title="Batch Mode">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/icon.png" />
                </TitleBar.IconSource>
            </TitleBar>
        </Border>

        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="Output folder" />
                <TextBox
                    x:Name="FolderBox"
                    Grid.Column="1"
                    AutomationProperties.Name="Output folder"
                    IsReadOnly="True"
                    PlaceholderText="Choose where the results go" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Choose the output folder"
                    Click="OnBrowse"
                    Content="Browse…" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2">
            <StackPanel
                x:Name="Items"
                Padding="16"
                Spacing="16" />
        </ScrollViewer>
        <StackPanel
            x:Name="Empty"
            Grid.Row="2"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
            <FontIcon
                FontSize="40"
                Glyph="&#xE896;"
                Opacity="0.6" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Drop scans here, or click Add Files" />
            <TextBlock
                MaxWidth="420"
                HorizontalAlignment="Center"
                Style="{StaticResource Hint}"
                Text="Each scan is processed in turn and saved as a PNG in the output folder, named like an export. Add a disc's scans over white and over black together and they're paired up and matted automatically."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            x:Name="BusyPanel"
            Grid.Row="2"
            Padding="24,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="32"
                    Height="32"
                    AutomationProperties.Name="Working"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyText"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="3"
            Padding="16,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.Name="Cancel the batch"
                    Click="OnCancel"
                    Content="Cancel"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Stop: the scan being worked on isn't saved, and the ones waiting aren't started" />
                <TextBlock
                    x:Name="ProgressText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Add Files"
                    Click="OnAddFiles"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Add scans: each is processed in turn and saved as a PNG in the output folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock Text="Add Files" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
