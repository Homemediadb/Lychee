<UserControl
    x:Class="Lychee.Gui.Controls.SaveOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="SavingBadge" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SuccessBadge" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="FailedBadge" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid
        Background="{ThemeResource SmokeFillColorDefaultBrush}"
        KeyDown="OnKeyDown"
        TabFocusNavigation="Cycle">
        <Border
            MinWidth="440"
            Margin="24"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Grid
                        x:Name="Badge"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="BadgeIcon"
                            FontSize="16"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextLineBounds="Tight" />
                    <Button
                        x:Name="XButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Margin="0,-12,-12,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnX">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="FileText"
                    HorizontalAlignment="Left"
                    FontWeight="SemiBold"
                    IsTextSelectionEnabled="True"
                    SizeChanged="OnFileTextSizeChanged"
                    TextWrapping="Wrap" />
                <Grid
                    x:Name="ProgressPanel"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="6">
                    <ProgressBar
                        x:Name="Bar"
                        Grid.ColumnSpan="2"
                        AutomationProperties.Name="Save progress"
                        Maximum="1" />
                    <TextBlock
                        x:Name="StageText"
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Name="PercentText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ScrollViewer
                    x:Name="DetailScroll"
                    MaxHeight="280"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="DetailText"
                        MaxWidth="380"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </ScrollViewer>
                <Grid
                    x:Name="Facts"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16"
                    Visibility="Collapsed">
                    <TextBlock x:Name="FactLabels" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="FactValues"
                        Grid.Column="1"
                        IsTextSelectionEnabled="True" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
