<UserControl
    x:Class="Lychee.Gui.Controls.StageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Root"
        Background="Transparent"
        DoubleTapped="OnDoubleTapped"
        PointerCaptureLost="OnReleased"
        PointerMoved="OnMoved"
        PointerPressed="OnPressed"
        PointerReleased="OnReleased"
        PointerWheelChanged="OnWheel"
        SizeChanged="OnSizeChanged">
        <!--  Canvases, so what they hold runs past the stage's edges unclipped  -->
        <Canvas x:Name="Behind">
            <Image x:Name="Checker" Stretch="Fill" />
            <Image
                x:Name="PlasmaImage"
                Stretch="Fill"
                Visibility="Collapsed" />
        </Canvas>
        <Canvas>
            <Image
                x:Name="Picture"
                RenderTransformOrigin="0,0"
                Stretch="Fill">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="Place" />
                </Image.RenderTransform>
            </Image>
            <Rectangle
                x:Name="Frame"
                StrokeThickness="1"
                Visibility="Collapsed">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="FrameTurn" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle
                x:Name="HighlightFrame"
                Stroke="#A0000000"
                StrokeThickness="1"
                Visibility="Collapsed">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="HighlightTurn" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <Canvas
            x:Name="Guides"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <ProgressRing
            x:Name="Spinner"
            Width="40"
            Height="40"
            AutomationProperties.Name="Working"
            IsActive="False" />
        <Border
            x:Name="StatusBadge"
            Margin="16,88,16,0"
            Padding="8,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusText"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
        <TextBlock
            x:Name="Message"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0.6"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Button
            x:Name="ZoomBadge"
            MinWidth="0"
            MinHeight="0"
            Margin="8"
            Padding="8,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Zoom: fit to the stage"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Click="OnZoomClick"
            CornerRadius="4"
            ToolTipService.ToolTip="Fit to the stage"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ZoomText"
                AutomationProperties.LiveSetting="Polite"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12" />
        </Button>
        <Button
            x:Name="AngleBadge"
            MinWidth="0"
            MinHeight="0"
            Margin="8"
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.Name="Rotation: turn back straight"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Click="OnAngleClick"
            CornerRadius="4"
            ToolTipService.ToolTip="Turn back straight"
            Visibility="Collapsed">
            <TextBlock
                x:Name="AngleText"
                AutomationProperties.LiveSetting="Polite"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12" />
        </Button>
    </Grid>
</UserControl>
