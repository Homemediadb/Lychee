<UserControl x:Class="Lychee.Gui.Controls.StageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" SizeChanged="OnSizeChanged"
          PointerWheelChanged="OnWheel" PointerPressed="OnPressed" PointerMoved="OnMoved"
          PointerReleased="OnReleased" PointerCaptureLost="OnReleased" DoubleTapped="OnDoubleTapped">
        <!-- Canvases, so what they hold runs past the stage's edges unclipped -->
        <Canvas x:Name="Behind">
            <Image x:Name="Checker" Stretch="Fill" />
            <Image x:Name="PlasmaImage" Stretch="Fill" Visibility="Collapsed" />
        </Canvas>
        <Canvas>
            <Image x:Name="Picture" Stretch="Fill" RenderTransformOrigin="0,0">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="Place" />
                </Image.RenderTransform>
            </Image>
            <Rectangle x:Name="Frame" StrokeThickness="1" Visibility="Collapsed">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="FrameTurn" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="HighlightFrame" StrokeThickness="1" Visibility="Collapsed" Stroke="#A0000000">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="HighlightTurn" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <Canvas x:Name="Guides" IsHitTestVisible="False" Visibility="Collapsed" />
        <ProgressRing x:Name="Spinner" Width="40" Height="40" IsActive="False" AutomationProperties.Name="Working" />
        <Border x:Name="StatusBadge" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,88,16,0" Padding="8,4" CornerRadius="4"
                Visibility="Collapsed" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap"
                   TextAlignment="Center" Visibility="Collapsed" />
        <Button x:Name="ZoomBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,4" MinWidth="0" MinHeight="0"
                CornerRadius="4" Visibility="Collapsed" Click="OnZoomClick" ToolTipService.ToolTip="Fit to the stage"
                AutomationProperties.Name="Zoom: fit to the stage"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="ZoomText" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.LiveSetting="Polite" />
        </Button>
        <Button x:Name="AngleBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4" MinWidth="0" MinHeight="0"
                CornerRadius="4" Visibility="Collapsed" Click="OnAngleClick" ToolTipService.ToolTip="Turn back straight"
                AutomationProperties.Name="Rotation: turn back straight"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="AngleText" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.LiveSetting="Polite" />
        </Button>
    </Grid>
</UserControl>
