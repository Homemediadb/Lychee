<UserControl x:Class="Lychee.Gui.Controls.DropOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
    <UserControl.Resources>
        <Storyboard x:Name="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="HideStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
        </Storyboard>
        <Storyboard x:Name="BobStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="IconShift" Storyboard.TargetProperty="Y" From="-6" To="4" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <AcrylicBrush TintColor="{ThemeResource SystemAccentColorDark2}" TintOpacity="0.35"
                          FallbackColor="{ThemeResource SystemAccentColorDark2}" />
        </Grid.Background>
        <Grid Margin="16">
            <Rectangle x:Name="Frame" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5,4"
                       Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="CardScale" />
                </StackPanel.RenderTransform>
                <Grid Width="96" Height="96" CornerRadius="48" HorizontalAlignment="Center" Margin="0,0,0,6"
                      Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon x:Name="Icon" Glyph="&#xE896;" FontSize="44" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                        <FontIcon.RenderTransform>
                            <TranslateTransform x:Name="IconShift" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Grid>
                <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="White" />
                <TextBlock x:Name="DetailText" HorizontalAlignment="Center" Opacity="0.85" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
