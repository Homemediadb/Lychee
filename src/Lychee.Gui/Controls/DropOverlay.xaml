<UserControl
    x:Class="Lychee.Gui.Controls.DropOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    Opacity="0"
    Visibility="Collapsed">
    <UserControl.Resources>
        <Storyboard x:Name="ShowStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="Root"
                Storyboard.TargetProperty="Opacity"
                To="1"
                Duration="0:0:0.16" />
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.94"
                To="1"
                Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.94"
                To="1"
                Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="HideStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="Root"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.12" />
        </Storyboard>
        <Storyboard
            x:Name="BobStoryboard"
            AutoReverse="True"
            RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="IconShift"
                Storyboard.TargetProperty="Y"
                From="-6"
                To="4"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.Background>
            <AcrylicBrush
                FallbackColor="{ThemeResource SystemAccentColorDark2}"
                TintColor="{ThemeResource SystemAccentColorDark2}"
                TintOpacity="0.35" />
        </Grid.Background>
        <Grid Margin="16">
            <Rectangle
                x:Name="Frame"
                RadiusX="12"
                RadiusY="12"
                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                StrokeDashArray="5,4"
                StrokeThickness="2" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Spacing="10">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="CardScale" />
                </StackPanel.RenderTransform>
                <Grid
                    Width="96"
                    Height="96"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="48">
                    <FontIcon
                        x:Name="Icon"
                        FontSize="44"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE896;">
                        <FontIcon.RenderTransform>
                            <TranslateTransform x:Name="IconShift" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Grid>
                <TextBlock
                    x:Name="TitleText"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="DetailText"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Opacity="0.85" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
