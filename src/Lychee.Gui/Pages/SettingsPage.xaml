<UserControl x:Class="Lychee.Gui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16,0">
        <!-- ScrollViewer places content by its desired width: this Grid centers the capped page -->
        <Grid>
        <StackPanel Spacing="12" MaxWidth="960" Margin="0,12">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" AutomationProperties.Name="Theme" HorizontalAlignment="Stretch" SelectionChanged="SettingChanged">
                            <ComboBoxItem Content="Use system setting" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Auto Rotation" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Turn each disc so its print reads level" />
                                <TextBlock Style="{StaticResource Hint}" Text="Read with Windows' own OCR once the first result is ready, and in Batch Mode before saving. A disc with no print it can read stays as scanned." />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoRotationSwitch" Grid.Column="1" AutomationProperties.Name="Auto Rotation" OnContent="On" OffContent="Off" MinWidth="0" Toggled="SettingChanged" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <TextBlock Text="Language of the print" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" AutomationProperties.Name="Language of the print" HorizontalAlignment="Stretch" SelectionChanged="SettingChanged" />
                            <TextBlock Grid.Row="1" Text="Largest turn" VerticalAlignment="Center" />
                            <ComboBox x:Name="MaxRotationCombo" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Largest turn" HorizontalAlignment="Stretch" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="Any" Tag="180" />
                                <ComboBoxItem Content="Up to 90° either way" Tag="90" />
                                <ComboBoxItem Content="Up to 45° either way" Tag="45" />
                                <ComboBoxItem Content="Up to 15° either way (straighten a tilt)" Tag="15" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Languages are the OCR languages installed in Windows (Settings, Time &amp; language, Language &amp; region). A larger turn than allowed leaves the disc as scanned." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Files" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Saved file name suffix" />
                        <TextBox x:Name="SuffixBox" LostFocus="SettingChanged" AutomationProperties.Name="Saved file name suffix" />
                        <TextBlock Style="{StaticResource Hint}" Text="Added to the scan's name to suggest the saved file's name. The command line always uses _nobg." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
