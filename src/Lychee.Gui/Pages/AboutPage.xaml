<UserControl
    x:Class="Lychee.Gui.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconLink" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style
            x:Key="GroupLabel"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="InlineLink" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style
            x:Key="Version"
            BasedOn="{StaticResource Mono}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="16,0">
        <Grid
            MaxWidth="960"
            Margin="0,24"
            ColumnDefinitions="*,384"
            ColumnSpacing="48">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image
                        Width="64"
                        Height="64"
                        Source="ms-appx:///Assets/icon-square.png" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Lychee" />
                            <Border
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <TextBlock
                                    x:Name="VersionText"
                                    FontSize="13"
                                    Style="{StaticResource Mono}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" Text="Removes the white scanner background from disc scans, keeping the shadow." />
                        <StackPanel
                            Margin="-4,2,0,0"
                            Orientation="Horizontal"
                            Spacing="4">
                            <HyperlinkButton
                                AutomationProperties.Name="Support on Ko-fi"
                                NavigateUri="https://ko-fi.com/rlaphoenix"
                                Style="{StaticResource IconLink}"
                                ToolTipService.ToolTip="Support on Ko-fi">
                                <Viewbox Width="20" Height="20">
                                    <PathIcon Data="F0 M1,3 H12 V10 A4,4 0 0 1 8,14 H5 A4,4 0 0 1 1,10 Z M6.5,11.2 L4.1,8.8 A1.35,1.35 0 0 1 6.5,6.9 A1.35,1.35 0 0 1 8.9,8.8 Z M12,4.5 H13 A3,3 0 0 1 13,10.5 H12 V9 H13 A1.5,1.5 0 0 0 13,6 H12 Z" />
                                </Viewbox>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Body}" Text="Copyright © 2026 rlaphoenix" />
                    <TextBlock Style="{StaticResource Body}" Text="Licensed under GNU GPL v3.0, with absolutely no warranty." />
                </StackPanel>

                <TextBlock Style="{StaticResource GroupLabel}" Text="COMMAND LINE" />
                <TextBlock xml:space="preserve" Style="{StaticResource Body}"><Run Text="Run Lychee.exe from a terminal with scans to process them without the window; " /><Run FontFamily="Cascadia Mono, Consolas" Text="Lychee --help" /><Run Text=" lists the options." /></TextBlock>

                <TextBlock Style="{StaticResource GroupLabel}" Text="DEPENDENCIES" />
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="4">
                    <HyperlinkButton
                        Content=".NET"
                        NavigateUri="https://dot.net"
                        Style="{StaticResource InlineLink}" />
                    <TextBlock
                        x:Name="DotnetText"
                        Grid.Column="1"
                        Style="{StaticResource Version}" />
                    <HyperlinkButton
                        Grid.Row="1"
                        Content="Windows App SDK"
                        NavigateUri="https://github.com/microsoft/WindowsAppSDK"
                        Style="{StaticResource InlineLink}" />
                    <TextBlock
                        x:Name="WinAppSdkText"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource Version}"
                        Text="unknown" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Shortcuts" />
                <StackPanel x:Name="ShortcutList" Spacing="6" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
