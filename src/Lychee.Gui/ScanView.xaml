<UserControl x:Class="Lychee.Gui.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Lychee.Gui.Controls">
    <Grid RowDefinitions="Auto,*">
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="FileBar" Padding="12,10,16,10" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="BeforeButton" AutomationProperties.Name="Before" MinWidth="88" CornerRadius="4,0,0,4" Click="OnViewToggle"
                                  ToolTipService.ToolTip="The scan as opened (B)">
                        <TextBlock Text="Before" />
                    </ToggleButton>
                    <ToggleButton x:Name="AfterButton" AutomationProperties.Name="After" MinWidth="88" CornerRadius="0,4,4,0" IsChecked="True" Click="OnViewToggle"
                                  ToolTipService.ToolTip="With the background removed, exactly as saved (B)">
                        <TextBlock Text="After" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <CheckBox x:Name="MattingBox" MinWidth="0" Padding="0" Click="OnMattingBoxClick" AutomationProperties.Name="Use matting"
                              ToolTipService.ToolTip="Use the black scan: on, the hole and clear plastic are matted; off, the white scan alone" />
                    <Button x:Name="MattingButton" Click="OnMattingClick" AutomationProperties.Name="Matting">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <TextBlock x:Name="MattingTip" TextWrapping="Wrap" MaxWidth="320" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                            <TextBlock Text="Matting…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="InfoPanel" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="SizeText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="DpiText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
                <Grid Grid.Column="3" Width="144" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <Button x:Name="SaveButton" HorizontalAlignment="Stretch" AutomationProperties.Name="Export As" Click="OnSave" Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Export the result as a PNG with transparency (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Export As" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyButton" Grid.Column="1" Padding="9,8" AutomationProperties.Name="Copy" Click="OnCopy"
                            ToolTipService.ToolTip="Copy the result to the clipboard, with transparency (Ctrl+Shift+C)">
                        <Grid>
                            <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="14" />
                            <FontIcon x:Name="CopiedIcon" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,176">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid x:Name="StageArea" SizeChanged="OnStageAreaSizeChanged">
                    <controls:StageView x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <controls:BackdropList x:Name="Backdrops" Margin="16" />
            </ScrollViewer>
        </Grid>

        <controls:SaveOverlay x:Name="SaveOverlay" Grid.RowSpan="2" />
    </Grid>
</UserControl>
